# Optional LLM configuration. Copy this file to .env in the directory where you run
# nist-rag. Without a key, use --no-llm for deterministic extractive generation.

# OpenAI-compatible provider credentials and model name.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini also supports the OpenAI-compatible protocol. To use Gemini, keep the
# variable names above but use values like these instead:
# OPENAI_API_KEY=your_gemini_api_key
# OPENAI_MODEL=gemini-3.6-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
